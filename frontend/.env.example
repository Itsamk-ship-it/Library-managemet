# Frontend environment configuration

# Base URL for the API. In dev, leave unset to use the Vite proxy (/api -> backend).
# In production set to the full API origin, e.g. https://api.example.com/api
# VITE_API_URL=/api

# Dev-only: where the Vite dev server proxies /api requests.
VITE_API_PROXY=http://localhost:4000
